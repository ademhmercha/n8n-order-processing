    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst { orderId, customerId, productId, quantity } = body;\n\nconst errors = [];\nif (!orderId) errors.push('orderId is required');\nif (!customerId) errors.push('customerId is required');\nif (!productId) errors.push('productId is required');\nif (!quantity || quantity <= 0) errors.push('quantity must be a positive number');\n\nif (errors.length > 0) {\n  throw new Error('Validation failed: ' + errors.join(', '));\n}\n\nreturn [{\n  json: {\n    orderId,\n    customerId,\n    productId,\n    quantity: Number(quantity)\n  }\n}];"
      },
      "id": "448b4347-0d73-43fa-8b61-df0afca5ae10",
      "name": "Validate Order Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        368
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, stock_quantity, price FROM products WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ $json.productId }}"
        }
      },
      "id": "30591051-1e5f-4dcf-a427-0b9faffaa054",
      "name": "Check Product Stock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -752,
        368
      ],
      "credentials": {
        "postgres": {
          "id": "Ph55o2Pnwvn3qDnv",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge stock-check result with original order data\nconst order = $('Validate Order Data').first().json;\nconst product = $input.first().json;\n\nconst inStock = product && Number(product.stock_quantity) >= Number(order.quantity);\n\nreturn [{\n  json: {\n    ...order,\n    productName: product ? product.name : null,\n    availableStock: product ? Number(product.stock_quantity) : 0,\n    price: product ? Number(product.price) : 0,\n    inStock\n  }\n}];"
      },
      "id": "1fcb7668-935d-4880-bbf4-87fdf50dc0a6",
      "name": "Merge Order + Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
