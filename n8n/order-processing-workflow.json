    {
      "parameters": {
        "jsCode": "const order = $('Merge Order + Stock').first().json;\n\nconst invoiceNumber = 'INV-' + Date.now() + '-' + order.orderId;\nconst total = (order.price * order.quantity).toFixed(2);\nconst filePath = `/invoices/${invoiceNumber}.pdf`;\n\nreturn [{\n  json: {\n    ...order,\n    invoiceNumber,\n    total,\n    filePath\n  }\n}];"
      },
